# Apple notarization credentials. Copy to `.env.notarize` and fill in.
# .env.notarize is gitignored — never commit real credentials.

# The Apple ID email you used to enroll in the Apple Developer Program.
APPLE_ID=your.apple.id@example.com

# App-specific password generated at appleid.apple.com.
# Format: xxxx-xxxx-xxxx-xxxx
APPLE_APP_SPECIFIC_PASSWORD=

# Your Apple Developer team identifier — matches the (...) in your
# Developer ID Application cert name. Found via:
#   security find-identity -v -p codesigning
APPLE_TEAM_ID=xxxxxxxx
