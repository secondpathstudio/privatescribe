# Caddyfile template for PrivateScribe server mode (roadmap Phase 9).
#
# Rendered at server-setup time by the service layer (Phase 9 item 3): the
# {{PLACEHOLDERS}} are substituted with the deployment's real values, the
# result is written next to the data dir, and the bundled Caddy
# (Resources/caddy-runtime/caddy) is launched with `caddy run --config <file>`.
#
# Caddy is the only LAN-facing process: it terminates TLS, serves the built
# SPA, and reverse-proxies the API to the backend on loopback. The backend
# itself never binds anything but 127.0.0.1.

{
	# Caddy's own admin API off — this is a fixed single-site config, and the
	# endpoint would otherwise listen on localhost:2019.
	admin off
	# Don't try to install Caddy's CA into the system trust store (it would
	# prompt for / fail on sudo in a daemon). Clients pin the cert fingerprint
	# on first connect instead (trust-on-first-use), so system trust isn't needed.
	skip_install_trust
}

# Listen on the LAN port for ANY host. tls internal + on_demand makes Caddy's
# local CA mint a leaf cert on the fly for whatever host/IP a client connects
# as (localhost on this Mac, the LAN IP from clients) — so a single bind serves
# every reachable name without knowing them up front. No public CA, no internet;
# clients trust-on-first-use the fingerprint (Phase 10 pairing).
:{{LAN_PORT}} {
	tls internal {
		on_demand
	}

	# API → backend on loopback (plain HTTP; never leaves the host).
	handle /api/* {
		reverse_proxy 127.0.0.1:{{BACKEND_PORT}}
	}

	# Everything else is the built single-page app. try_files makes client-side
	# routes (deep links / refresh) resolve to index.html.
	handle {
		root * {{FRONTEND_ROOT}}
		try_files {path} /index.html
		file_server
	}
}
